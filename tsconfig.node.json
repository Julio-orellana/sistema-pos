{
  "extends": "./tsconfig.base.json",
  "include": [
    "src/main/**/*.ts",
    "src/shared/**/*.ts",
    "electron.vite.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["src/main/preload/**/*.ts"],
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2023"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@main/*": ["src/main/*"]
    },
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.node.tsbuildinfo"
  }
}
