# ==========================================================================
# .gitignore — POS Agrícola (cliente: Jimmy Cano)
# Creado ANTES de inicializar git, para que ningún artefacto ni secreto
# quede registrado en el historial desde el commit inicial.
# ==========================================================================

# --- Dependencias -------------------------------------------------------
node_modules/
.pnp/
.pnp.js
jspm_packages/

# --- Salidas de build (Vite / electron-vite) ----------------------------
dist/
dist-electron/
dist-ssr/
out/
.vite/

# --- Empaquetado de electron-builder ------------------------------------
release/
release-builds/
app-builds/
*.dmg
*.pkg
*.exe
*.msi
*.AppImage
*.deb
*.rpm
*.snap
*.blockmap
*.zip.blockmap

# --- Binarios nativos compilados (better-sqlite3 y cualquier .node) -----
# Ojo: NO se ignora la carpeta "build/" completa, porque electron-builder.yml
# la declara como buildResources (ahí van los iconos del instalador, que sí se
# versionan). Solo se ignoran los artefactos de compilación que hay dentro.
# better-sqlite3 se recompila contra el ABI de Electron en cada máquina;
# su binario NUNCA se versiona.
*.node
build/Release/
build/Debug/
prebuilds/
node_modules/better-sqlite3/build/
node_modules/better-sqlite3/prebuilds/
.node-gyp/
.electron-gyp/
.cache/electron/
.cache/electron-builder/

# --- Variables de entorno y secretos ------------------------------------
# Incluye las llaves de Supabase: jamás deben entrar al repositorio.
.env
.env.*
!.env.example
!.env.nube-pruebas.ejemplo
*.pem
*.key
*.p12
*.mobileprovision
secrets.json

# --- Bases de datos locales de desarrollo --------------------------------
# Los archivos SQLite son datos de la tienda, no código fuente.
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
data/local/

# --- Logs ----------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm/
.eslintcache

# --- Reportes de pruebas y cobertura -------------------------------------
coverage/
.nyc_output/
test-results/

# --- Sistema operativo ---------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Editores e IDE ------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.idea/
*.iml
*.sublime-project
*.sublime-workspace
.history/
*.swp
*.swo
*~

# --- Temporales del proyecto ---------------------------------------------
tmp/
temp/
.tmp/
*.tsbuildinfo
