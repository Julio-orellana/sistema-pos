{
  "extends": "./tsconfig.base.json",
  "include": ["src/main/preload/**/*.ts", "src/shared/**/*.ts"],
  "compilerOptions": {
    "composite": true,
    // El preload corre en el contexto del renderer: necesita los tipos del DOM
    // (window, addEventListener) además de los de Node. Se separa del tsconfig
    // del proceso principal justamente para que el main NO vea el DOM y nadie
    // pueda usar APIs de navegador donde no existen.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"]
    },
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.preload.tsbuildinfo"
  }
}
