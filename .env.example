# ==========================================================================
# Plantilla de variables de entorno — copiar a .env y llenar con valores reales.
# El archivo .env está en .gitignore y NUNCA se sube al repositorio.
# ==========================================================================

# --- Supabase (plan GRATUITO durante todo el desarrollo) ------------------
# Mientras estas variables estén vacías o ausentes, el sistema usa el
# SyncProvider simulado y no realiza ninguna llamada de red. Esto es
# deliberado: evita consumir la cuota gratuita de Supabase mientras se
# trabaja en otras partes del sistema.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Selección de adaptadores (ver docs/INTEGRACIONES.md) -----------------
# POS_SYNC_PROVIDER: "simulado" (por defecto) | "supabase"
POS_SYNC_PROVIDER=simulado
# POS_PRINTER_PROVIDER: "nulo" (por defecto, solo PDF) | "escpos"
POS_PRINTER_PROVIDER=nulo

# --- Salida controlada del modo kiosko ------------------------------------
# PIN que autoriza cerrar la aplicación con el atajo del administrador.
# Entre 4 y 12 dígitos.
# En DESARROLLO, si se deja vacío se usa 0000 y la consola lo advierte.
# En PRODUCCIÓN, si se deja vacío la salida controlada queda deshabilitada.
# TODO(usuarios): cuando exista el módulo de usuarios, el PIN saldrá de la base
# de datos como hash y esta variable desaparecerá.
POS_PIN_ADMINISTRADOR=
