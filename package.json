{
  "name": "pos-agricola",
  "version": "1.2.0",
  "private": true,
  "description": "Sistema de punto de venta de escritorio para tienda de productos agricolas (venta a granel y por unidad, detalle y mayoreo). Cliente: Jimmy Cano, Guatemala.",
  "author": "Julio Orellana",
  "license": "UNLICENSED",
  "main": "./dist-electron/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win --x64",
    "typecheck": "npm run typecheck:node && npm run typecheck:preload && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:preload": "tsc --noEmit -p tsconfig.preload.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "rebuild": "electron-builder install-app-deps",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "verify:arranque": "npm run build && POS_VERIFICACION_ARRANQUE=1 electron .",
    "verify:pantallas": "POS_COMPILAR_SIN_NUBE=1 npm run build && node scripts/verificacion-de-pantallas.cjs",
    "verify:pantallas:caja": "POS_COMPILAR_SIN_NUBE=1 npm run build && node scripts/verificacion-de-caja-y-teclado.cjs",
    "verify:pantallas:impresora": "POS_COMPILAR_SIN_NUBE=1 npm run build && node scripts/verificacion-de-impresora.cjs",
    "verify:pantallas:cobro-sin-esperar-impresora": "POS_COMPILAR_SIN_NUBE=1 npm run build && node scripts/verificacion-de-cobro-sin-esperar-impresora.cjs",
    "verify:pantallas:teclado": "POS_COMPILAR_SIN_NUBE=1 npm run build && node scripts/verificacion-de-teclado-en-pantalla.cjs",
    "verify:arranque:sin-respuesta-de-red": "POS_COMPILAR_SIN_NUBE=1 npm run build && node scripts/verificacion-de-arranque-sin-respuesta-de-red.cjs",
    "verify:pantallas:historial-de-cajas": "POS_COMPILAR_SIN_NUBE=1 npm run build && node scripts/verificacion-de-historial-de-cajas.cjs",
    "verify:pantallas:anulacion": "POS_COMPILAR_SIN_NUBE=1 npm run build && node scripts/verificacion-de-anulacion.cjs",
    "verify:pantallas:recibos": "POS_COMPILAR_SIN_NUBE=1 npm run build && node scripts/verificacion-de-historial-de-recibos.cjs",
    "verify:pantallas:1024": "POS_COMPILAR_SIN_NUBE=1 npm run build && node scripts/verificacion-de-pantallas-1024.cjs",
    "verify:paquete": "node scripts/verificacion-de-paquete.cjs",
    "seed:ejemplo": "npm run build && electron . --datos-de-ejemplo=sembrar",
    "seed:limpiar": "npm run build && electron . --datos-de-ejemplo=limpiar",
    "seed:limites": "npm run build && electron . --limites-descuento=sembrar",
    "seed:limites:limpiar": "npm run build && electron . --limites-descuento=limpiar",
    "diagnostico:kiosko-macos": "mkdir -p node_modules/.tmp && swiftc -O scripts/sonda-presentacion-macos.swift -o node_modules/.tmp/sonda-presentacion && electron scripts/diagnostico-kiosko-macos.cjs kiosk node_modules/.tmp/sonda-presentacion && electron scripts/diagnostico-kiosko-macos.cjs corregido node_modules/.tmp/sonda-presentacion",
    "diagnostico:credencial": "electron scripts/sonda-de-credencial.cjs",
    "postinstall": "electron-builder install-app-deps",
    "verify:nube": "node scripts/verificacion-de-nube.cjs",
    "fotos:reducir": "npm run build && electron . --reducir-fotos",
    "diagnostico:imagen": "electron scripts/sonda-de-imagen.cjs",
    "icono": "electron scripts/generar-icono.cjs",
    "verify:restauracion": "vitest run --config vitest.nube.config.ts",
    "verify:restauracion:renovacion": "POS_NUBE_RENOVACION=1 vitest run --config vitest.nube.config.ts renovacion-de-sesion",
    "verify:pantallas:restauracion": "npm run build && node scripts/verificacion-de-restauracion-en-pantalla.cjs",
    "ensayo:restauracion": "npm run build && node scripts/ensayo-de-restauracion.cjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "decimal.js": "^10.6.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.63.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  }
}
