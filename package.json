{
  "name": "pos-agricola",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de punto de venta de escritorio para tienda de productos agricolas (venta a granel y por unidad, detalle y mayoreo). Cliente: Jimmy Cano, Guatemala.",
  "author": "Julio Orellana",
  "license": "UNLICENSED",
  "main": "./dist-electron/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "typecheck": "npm run typecheck:node && npm run typecheck:preload && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:preload": "tsc --noEmit -p tsconfig.preload.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "rebuild": "electron-builder install-app-deps",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "verify:arranque": "npm run build && POS_VERIFICACION_ARRANQUE=1 electron .",
    "verify:pantallas": "npm run build && node scripts/verificacion-de-pantallas.cjs",
    "seed:ejemplo": "npm run build && electron . --datos-de-ejemplo=sembrar",
    "seed:limpiar": "npm run build && electron . --datos-de-ejemplo=limpiar",
    "seed:limites": "npm run build && electron . --limites-descuento=sembrar",
    "seed:limites:limpiar": "npm run build && electron . --limites-descuento=limpiar",
    "diagnostico:kiosko-macos": "mkdir -p node_modules/.tmp && swiftc -O scripts/sonda-presentacion-macos.swift -o node_modules/.tmp/sonda-presentacion && electron scripts/diagnostico-kiosko-macos.cjs kiosk node_modules/.tmp/sonda-presentacion && electron scripts/diagnostico-kiosko-macos.cjs corregido node_modules/.tmp/sonda-presentacion",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "decimal.js": "^10.6.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.63.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  }
}
