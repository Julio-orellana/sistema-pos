# Credenciales para `npm run verify:nube`. Copiar a `.env.nube-pruebas` (que git
# ignora) y completar. SOLO del proyecto de pruebas descartable: la referencia
# del proyecto real (pos-jimmy-cano) está prohibida por nombre en el modo
# destructivo, y ninguna de estas credenciales viaja en la aplicación.
POS_NUBE_PROYECTO=ztidrshifrblhfraiowg
POS_NUBE_URL=https://ztidrshifrblhfraiowg.supabase.co
POS_NUBE_LLAVE_PUBLICABLE=sb_publishable_...
POS_NUBE_TERMINAL_CORREO=terminal-pruebas@pos-pruebas.invalid
POS_NUBE_TERMINAL_CLAVE=
POS_NUBE_RESTAURACION_CORREO=restauracion-pruebas@pos-pruebas.invalid
POS_NUBE_RESTAURACION_CLAVE=
POS_NUBE_SIN_ROL_CORREO=sin-rol-pruebas@pos-pruebas.invalid
POS_NUBE_SIN_ROL_CLAVE=
# Solo para que `--destructivo` vacíe las tablas por su cuenta. La service_role
# del proyecto de PRUEBAS, tomada del panel; NUNCA la del real. Si se omite, el
# guion sale con código 2 salvo que se le diga `--reinicio-hecho`.
# POS_NUBE_PRUEBAS_SERVICE_ROLE=
